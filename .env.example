# ——— Database (MySQL 8 via `docker compose up -d db`) ———
# Local dev (matches docker-compose.yml defaults):
DATABASE_URL="mysql://ffdgn:ffdgn-dev-change-me@127.0.0.1:3307/ffdgn"
MYSQL_ROOT_PASSWORD="ffdgn-root-change-me"
MYSQL_DATABASE="ffdgn"
MYSQL_USER="ffdgn"
MYSQL_PASSWORD="ffdgn-dev-change-me"

# ——— Auth (NextAuth v4, JWT sessions) ———
# Generate: openssl rand -base64 32  (or: npx auth secret)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE-ME-min-32-chars-in-every-environment"

# Session: 8h idle to match institutional session-timeout policy
SESSION_MAX_AGE="28800"

# ——— Rate limiting (production) ———
# Without REDIS_URL the limiter uses an in-process map, which enforces a quota
# per instance only: counters reset on deploy and an attacker spreads load
# across replicas. Set this in production. docker compose brings up a redis
# service; REDIS_URL="redis://127.0.0.1:6379".
# /api/healthz reports status "degraded" in production while this is unset.
REDIS_URL=""

# When Redis is unreachable the limiter fails OPEN (requests are allowed), since
# account lockout (failedLogins / lockedUntil) is stored in MySQL and survives
# both Redis loss and restarts. Set true to fail closed instead, trading
# availability for stricter throttling. Note: with this unset, a Redis outage
# leaves only the database-backed lockout protecting the login path.
RATE_LIMIT_FAIL_CLOSED="false"

# ——— Public site origin ———
# Absolute origin used for canonical URLs, sitemap.xml and robots.txt.
# Must match NEXTAUTH_URL in production or OAuth/callback origins break.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ——— Seeding ———
# The seed refuses to create its six development accounts (fixed passwords
# committed to source control, including a super_admin) when NODE_ENV=production
# or the DATABASE_URL host looks like production. Institutional content still
# loads in that case — only the accounts are skipped. Set this to true ONLY on a
# staging host that should carry the demo logins; real accounts are created with
# POST /api/v1/users as a super_admin.
ALLOW_DEV_ACCOUNTS="false"

# ——— Database hardening (optional, run once per production instance) ———
# `npm run db:harden` narrows the app account's MySQL grants: no GRANT OPTION,
# nothing outside its own schema, and no UPDATE/DELETE on audit_log, so the
# append-only trail cannot be rewritten by a compromised app. It needs an
# administrative account (root or similar) to revoke the app user's grants.
HARDEN_DB_ADMIN_USER="root"
HARDEN_DB_ADMIN_PASSWORD=""
