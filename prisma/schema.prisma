// FFDGN institutional schema — MySQL 8 production target (§27 / §31).
// Normalized: users ↔ members ↔ service history; events ↔ programme;
// documents with approval workflow; committees; audit trail (append-only).
// Managed with Prisma Migrate: `npx prisma migrate dev`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]

  // The client is generated on a developer machine (Windows/macOS) but runs on
  // the Linux host. Without an explicit Linux target, `prisma generate` emits
  // only the build platform's engine and the deployed app dies on first query
  // with "Prisma could not find the Query Engine for runtime OS linux".
  //
  // "native" keeps local development on its own platform. rhel-openssl-3.0.x
  // covers the CloudLinux/CentOS/AlmaLinux that cPanel shared hosting runs on;
  // debian-openssl-3.0.x covers Debian/Ubuntu hosts and container images.
  binaryTargets   = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  secretariat_admin
  membership_admin
  content_editor
  events_manager
  knowledge_manager
  committee_manager
  communications_officer
  auditor
  member
  associate
}

enum Visibility {
  PUBLIC
  MEMBERS_ONLY
  COMMITTEE_ONLY
  SECRETARIAT_ONLY
  PRIVATE
}

enum MemberCategory {
  Former
  Serving
  Secretariat
}

enum MemberStatus {
  Active
  Associate
  Honorary
  Pending
}

enum EventStatus {
  Upcoming
  Ongoing
  Past
}

enum NewsStatus {
  Draft
  Published
  Archived
}

enum RegistrationStatus {
  Registered
  Cancelled
}

enum DiscussionStatus {
  Open
  Locked
  Archived
}

enum RecommendationStatus {
  Draft
  Submitted
  Under_Review
  Approved
  Rejected
  Archived
}

enum DocStatus {
  Draft
  Editorial_Review
  Institutional_Review
  Approved
  Published
  Archived
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(192)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(member)
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  failedLogins Int      @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  member       Member?
  auditActions AuditLog[] @relation("AuditActor")
  eventRegistrations EventRegistration[]
  discussionThreads DiscussionThread[]
  discussionReplies DiscussionReply[]
  notifications Notification[]
  organizedMeetings CommitteeMeeting[]
  recommendations CommitteeRecommendation[]

  @@index([role])
  @@map("users")
}

model Member {
  id             String         @id @default(uuid())
  userId         String?        @unique @map("user_id")
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  slug           String         @unique @db.VarChar(128)
  fullName       String         @map("full_name") @db.VarChar(192)
  title          String         @db.VarChar(128)
  state          String         @db.VarChar(64)
  region         String         @db.VarChar(32)
  category       MemberCategory
  status         MemberStatus   @default(Pending)
  leadershipRole String?        @map("leadership_role") @db.VarChar(128)
  photoUrl       String?        @map("photo_url") @db.VarChar(512)
  bio            String?        @db.Text
  visibility     Visibility     @default(PUBLIC)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  service        ServiceRecord[]
  committeeSeats CommitteeSeat[]
  speakingAt     EventSpeaker[]
  engagedEvents  MemberEvent[]
  authoredDocs   MemberPublication[]

  @@index([state])
  @@index([category, status])
  @@fulltext([fullName, bio])
  @@map("members")
}

model ServiceRecord {
  id        String @id @default(uuid())
  memberId  String @map("member_id")
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  office    String @db.VarChar(128)
  state     String @db.VarChar(64)
  startYear Int    @map("start_year")
  endYear   Int    @map("end_year")

  @@index([memberId])
  @@map("service_history")
}

model ForumEvent {
  id        String      @id @default(uuid())
  slug      String      @unique @db.VarChar(128)
  title     String      @db.VarChar(255)
  theme     String      @db.VarChar(255)
  kind      String      @db.VarChar(64)
  startDate DateTime    @map("start_date") @db.Date
  endDate   DateTime    @map("end_date") @db.Date
  venue     String      @db.VarChar(255)
  city      String      @db.VarChar(128)
  status    EventStatus
  published Boolean     @default(true)
  summary   String      @db.Text
  /// Long-form write-up of what actually happened: attendance, resolutions,
  /// outcomes. Rendered as its own section on past events only — `summary` is
  /// the short standfirst that every event type shares.
  highlights String?    @map("highlights") @db.LongText
  guestList String?     @map("guest_list") @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  programme EventProgramme[]
  documents KnowledgeDoc[] @relation("EventDocuments")
  speakers  EventSpeaker[]
  guestSpeakers Speaker[] @relation("EventSpeakers")
  engagedMembers MemberEvent[]
  partnerLinks   PartnershipEvent[]
  newsLinks      NewsArticle[] @relation("NewsEvent")
  media     MediaAsset[] @relation("EventMedia")
  registrations EventRegistration[]
  coverUrl  String?     @map("cover_url") @db.VarChar(512)

  @@index([status, startDate])
  @@map("events")
}

model EventProgramme {
  id        String     @id @default(uuid())
  eventId   String     @map("event_id")
  event     ForumEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slotTime  String     @map("slot_time") @db.VarChar(16)
  session   String     @db.VarChar(255)
  speaker   String?    @db.VarChar(192)
  position  Int        @default(0)

  @@index([eventId, position])
  @@map("event_programme")
}

model KnowledgeDoc {
  id         String     @id @default(uuid())
  slug       String     @unique @db.VarChar(128)
  title      String     @db.VarChar(255)
  type       String     @db.VarChar(64)
  status     DocStatus  @default(Draft)
  publishedOn DateTime? @map("published_on") @db.Date
  author     String     @db.VarChar(192)
  topic      String     @db.VarChar(128)
  year       Int
  committee  String?    @db.VarChar(128)
  eventId    String?    @map("event_id")
  event      ForumEvent? @relation("EventDocuments", fields: [eventId], references: [id], onDelete: SetNull)
  pages      Int        @default(0)
  sizeLabel  String     @map("size_label") @db.VarChar(32)
  summary    String     @db.Text
  visibility Visibility @default(SECRETARIAT_ONLY)
  version    Int        @default(1)
  fileUrl    String?    @map("file_url") @db.VarChar(512)
  storageKey String?    @map("storage_key") @db.VarChar(255)
  downloads  Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  memberPubs MemberPublication[]
  newsLinks  NewsDoc[]

  @@index([status, visibility])
  @@index([year])
  @@fulltext([title, topic])
  @@map("documents")
}

model NewsArticle {
  id        String   @id @default(uuid())
  slug      String   @unique @db.VarChar(128)
  title     String   @db.VarChar(255)
  category  String   @db.VarChar(64)
  date      DateTime @db.Date
  location  String   @db.VarChar(128)
  excerpt   String   @db.Text
  body      String   @db.LongText
  official  Boolean  @default(true)
  status    NewsStatus @default(Published)
  imageUrl  String?  @map("image_url") @db.VarChar(512)
  eventId   String?  @map("event_id")
  event     ForumEvent? @relation("NewsEvent", fields: [eventId], references: [id], onDelete: SetNull)
  linkedDocs NewsDoc[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category, date])
  @@map("news")
}

model NewsDoc {
  id      String      @id @default(uuid())
  newsId  String      @map("news_id")
  news    NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)
  docId   String      @map("doc_id")
  doc     KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([newsId, docId])
  @@index([docId])
  @@map("news_docs")
}

model Committee {
  id        String   @id @default(uuid())
  slug      String   @unique @db.VarChar(128)
  name      String   @db.VarChar(192)
  mandate   String   @db.Text
  chairSlug String   @map("chair_slug") @db.VarChar(128)
  meetings  Int      @default(0)
  status    String   @db.VarChar(32)
  /// Card image for the committee. The public page falls back to the chair's
  /// portrait when this is null, so existing records render unchanged.
  imageUrl  String?  @map("image_url") @db.VarChar(500)
  /// Alt text for imageUrl. Must be non-empty whenever imageUrl is set.
  imageAlt  String?  @map("image_alt") @db.VarChar(300)
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  seats     CommitteeSeat[]
  meetingRecords CommitteeMeeting[]
  recommendations CommitteeRecommendation[]
  discussions DiscussionThread[]

  @@map("committees")
}

model CommitteeSeat {
  id         String    @id @default(uuid())
  committeeId String   @map("committee_id")
  committee  Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  memberId   String    @map("member_id")
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([committeeId, memberId])
  @@index([memberId])
  @@map("committee_seats")
}

model Partnership {
  id        String   @id @default(uuid())
  slug      String   @unique @db.VarChar(128)
  name      String   @db.VarChar(192)
  type      String   @db.VarChar(64)
  since     Int
  purpose   String   @db.Text
  published Boolean @default(true)
  logoUrl   String?  @map("logo_url") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cooperation PartnershipCooperation[]
  events      PartnershipEvent[]

  @@map("partnerships")
}

model PartnershipCooperation {
  id            String      @id @default(uuid())
  partnershipId String      @map("partnership_id")
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  area          String      @db.VarChar(255)
  position      Int         @default(0)

  @@index([partnershipId, position])
  @@map("partnership_cooperation")
}

model PartnershipEvent {
  id            String      @id @default(uuid())
  partnershipId String      @map("partnership_id")
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  eventId       String      @map("event_id")
  event         ForumEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([partnershipId, eventId])
  @@index([eventId])
  @@map("partnership_events")
}

// ——— Conference speakers (CMS-managed, own detail pages) ———

model Speaker {
  id         String     @id @default(uuid())
  slug       String     @unique @db.VarChar(128)
  name       String     @db.VarChar(192)
  honorific  String?    @db.VarChar(64)
  role       String     @db.VarChar(128)
  keynote    Boolean    @default(false)
  org        String?    @db.VarChar(192)
  bio        String?    @db.Text
  photoUrl   String?    @map("photo_url") @db.VarChar(512)
  eventId    String?    @map("event_id")
  event      ForumEvent? @relation("EventSpeakers", fields: [eventId], references: [id], onDelete: SetNull)
  visibility Visibility @default(PUBLIC)
  position   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([eventId, position])
  @@map("speakers")
}

// ——— CMS-managed institutional content (no hardcoded copy) ———

model SiteSetting {
  key       String   @id @db.VarChar(128)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model InstitutionalPage {
  id        String                 @id @default(uuid())
  slug      String                 @unique @db.VarChar(64)
  title     String                 @db.VarChar(255)
  eyebrow   String                 @db.VarChar(128)
  lede      String                 @db.Text
  body      String                 @db.LongText
  published Boolean                @default(true)
  updatedAt DateTime               @updatedAt @map("updated_at")
  sections  InstitutionalSection[]

  @@index([published, slug])
  @@map("institutional_pages")
}

/// Structured, optionally illustrated blocks within an institutional page.
/// Sections are the content model that carries imagery; `InstitutionalPage.body`
/// is only the closing prose note.
model InstitutionalSection {
  id        String            @id @default(uuid())
  pageId    String            @map("page_id")
  page      InstitutionalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String            @db.VarChar(200)
  body      String            @db.Text
  /// MediaAsset.url or an existing /public path, validated on write like
  /// homepage focus/timeline images. Null when the section is text only.
  imageUrl  String?           @map("image_url") @db.VarChar(500)
  /// Alt text for imageUrl. Must be non-empty whenever imageUrl is set.
  imageAlt  String?           @map("image_alt") @db.VarChar(300)
  position  Int               @default(0)
  published Boolean           @default(true)

  @@index([pageId, position])
  @@map("institutional_sections")
}

/// Membership roster of the Renewed Hope Agenda Peer Review Group (RHPRG).
///
/// Deliberately its own table rather than more institutional sections: the
/// roster is tabular, with per-row zone, role and contact fields that the page
/// renders as a real table (and that an admin can sort and edit row by row).
/// Sections are the prose model and cannot carry those fields without turning
/// each member into free-form text.
model PeerReviewMember {
  id        String   @id @default(uuid())
  /// Display order; doubles as the S/N column on the public table.
  position  Int
  name      String   @db.VarChar(200)
  /// Zonal representation: North Central, South South, FFDGN Rep, etc.
  zone      String   @db.VarChar(100)
  /// Chairman / Secretary / Member.
  role      String   @db.VarChar(100)
  phone     String?  @db.VarChar(50)
  email     String?  @db.VarChar(255)
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([position])
  @@map("peer_review_members")
}

model SiteMetric {
  id       String @id @default(uuid())
  key      String @unique @db.VarChar(64)
  value    String @db.VarChar(32)
  label    String @db.VarChar(128)
  href     String @db.VarChar(255)
  position Int    @default(0)

  @@map("site_metrics")
}

model FocusArea {
  id       String @id @default(uuid())
  slug     String @unique @db.VarChar(64)
  title    String @db.VarChar(128)
  text     String @db.Text
  href     String @db.VarChar(255)
  imageUrl String? @map("image_url") @db.VarChar(512)
  position Int    @default(0)
  published Boolean @default(true)

  @@map("focus_areas")
}

model TimelineEntry {
  id       String @id @default(uuid())
  year     Int
  title    String @db.VarChar(255)
  summary  String @db.Text
  imageUrl String? @map("image_url") @db.VarChar(512)
  position Int    @default(0)
  published Boolean @default(true)
  links    TimelineLink[]

  @@map("timeline_entries")
}

model TimelineLink {
  id      String        @id @default(uuid())
  entryId String        @map("entry_id")
  entry   TimelineEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  label   String        @db.VarChar(128)
  href    String        @db.VarChar(255)

  @@index([entryId])
  @@map("timeline_links")
}

model LeadershipSeat {
  id         String  @id @default(uuid())
  role       String  @db.VarChar(128)
  tier       Int     @default(2)
  memberSlug String  @map("member_slug") @db.VarChar(128)
  remit      String  @db.Text
  position   Int     @default(0)
  published  Boolean @default(true)

  @@map("leadership_seats")
}

// ——— Institutional relation joins (memory engine) ———

model EventSpeaker {
  id       String     @id @default(uuid())
  eventId  String     @map("event_id")
  event    ForumEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId String     @map("member_id")
  member   Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  position Int        @default(0)

  @@unique([eventId, memberId])
  @@index([memberId])
  @@map("event_speakers")
}

model MemberEvent {
  id       String     @id @default(uuid())
  memberId String     @map("member_id")
  member   Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventId  String     @map("event_id")
  event    ForumEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([memberId, eventId])
  @@index([eventId])
  @@map("member_events")
}

model MemberPublication {
  id       String       @id @default(uuid())
  memberId String       @map("member_id")
  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  docId    String       @map("doc_id")
  doc      KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([memberId, docId])
  @@index([docId])
  @@map("member_publications")
}

// ——— Media library (photos, videos, embeds) ———

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
}

model MediaAsset {
  id           String     @id @default(uuid())
  title        String     @db.VarChar(255)
  description  String?    @db.Text
  kind         MediaKind  @default(IMAGE)
  category     String     @db.VarChar(64)
  url          String     @db.VarChar(512)
  thumbnailUrl String?    @map("thumbnail_url") @db.VarChar(512)
  provider     String?    @db.VarChar(16)
  providerId   String?    @map("provider_id") @db.VarChar(128)
  durationSecs Int?       @map("duration_secs")
  width        Int?
  height       Int?
  photographer String?    @db.VarChar(192)
  copyright    String?    @db.VarChar(192)
  altText      String?    @map("alt_text") @db.VarChar(255)
  eventId      String?    @map("event_id")
  event        ForumEvent? @relation("EventMedia", fields: [eventId], references: [id], onDelete: SetNull)
  /// Whether this asset belongs in the public photo/video galleries.
  ///
  /// Uploads default to true because most are gallery material, but the library
  /// also holds brand marks, partner logos and UI art that are published for the
  /// media picker and must not pad the gallery. Gallery queries filter on this;
  /// the picker and the admin list ignore it.
  inGallery    Boolean    @default(true) @map("in_gallery")
  /// Year the photograph was taken, when it is known.
  ///
  /// Null means "infer": the gallery falls back to the linked event's year and
  /// then to the upload year. Kept separate from `createdAt` because historical
  /// archive scans are uploaded long after they were shot — without this the
  /// whole archive would read as one year.
  year         Int?       @map("capture_year")
  visibility   Visibility @default(PUBLIC)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([kind, category])
  @@index([eventId])
  @@map("media_assets")
}

// Append-only: no UPDATE/DELETE grants for app user in production.
model AuditLog {
  id            String   @id @default(uuid())
  actorId       String   @map("actor_id")
  actor         User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorName     String   @map("actor_name") @db.VarChar(192)
  action        String   @db.VarChar(128)
  resource      String   @db.VarChar(255)
  ip            String   @db.VarChar(64)
  previousValue String?  @map("previous_value") @db.Text
  newValue      String?  @map("new_value") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

// Public contact + newsletter submissions (no actor: unauthenticated visitors).
// Not part of the append-only audit trail — read by the Secretariat console.
model ContactMessage {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(255)
  subject   String   @db.VarChar(200)
  message   String   @db.Text
  ip        String?  @db.VarChar(64)
  handled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([handled, createdAt])
  @@map("contact_messages")
}

model EventRegistration {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String             @map("event_id")
  event     ForumEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status    RegistrationStatus @default(Registered)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@unique([userId, eventId])
  @@index([eventId, status])
  @@map("event_registrations")
}

model DiscussionThread {
  id          String           @id @default(uuid())
  title       String           @db.VarChar(255)
  body        String           @db.Text
  status      DiscussionStatus @default(Open)
  committeeId String?          @map("committee_id")
  committee   Committee?       @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  authorId    String           @map("author_id")
  author      User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  replies     DiscussionReply[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@index([committeeId, createdAt])
  @@map("discussion_threads")
}

model DiscussionReply {
  id        String          @id @default(uuid())
  threadId  String          @map("thread_id")
  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String          @map("author_id")
  author    User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String          @db.Text
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([threadId, createdAt])
  @@map("discussion_replies")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(192)
  body      String   @db.VarChar(512)
  href      String?  @db.VarChar(255)
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model CommitteeMeeting {
  id          String    @id @default(uuid())
  committeeId String    @map("committee_id")
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  organizerId String    @map("organizer_id")
  organizer   User      @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  title       String    @db.VarChar(255)
  startsAt    DateTime  @map("starts_at")
  location    String    @db.VarChar(255)
  agenda      String    @db.Text
  minutes     String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([committeeId, startsAt])
  @@map("committee_meetings")
}

model CommitteeRecommendation {
  id          String               @id @default(uuid())
  committeeId String               @map("committee_id")
  committee   Committee           @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  authorId    String               @map("author_id")
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title       String               @db.VarChar(255)
  rationale   String               @db.Text
  recommendation String            @db.LongText
  status      RecommendationStatus @default(Draft)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([committeeId, status, updatedAt])
  @@map("committee_recommendations")
}
